{
  "name": "adora-commerce-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "validate:static": "npm run lint && npm run typecheck && npm test && npm run build",
    "validate:carrier-webhook-e2e": "node supabase/validation/carrier-webhook-e2e.mjs",
    "validate:shipping-workflow": "node supabase/validation/shipping-workflow-suite.mjs",
    "validate:supabase-security": "node supabase/validation/supabase-security-suite.mjs",
    "validate:supabase-workflows": "node supabase/validation/supabase-workflows-suite.mjs",
    "validate:supabase": "npm run validate:supabase-security && npm run validate:supabase-workflows"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "lucide-react": "1.27.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "postcss": "8.5.23",
    "supabase": "2.109.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
